{
  "name": "json-explorer",
  "version": "1.1.1",
  "license": "MIT",
  "private": true,
  "homepage": "/",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "html-to-image": "1.11.11",
    "jsonc-parser": "^3.3.1",
    "jsonrepair": "^3.15.0",
    "lz-string": "^1.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-ga4": "^2.1.0",
    "react-scripts": "5.0.1",
    "reactflow": "^11.11.4",
    "web-vitals": "^2.1.4",
    "workbox-cli": "^7.3.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "postbuild": "workbox generateSW workbox-config.js",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "test:cli": "react-scripts test --watchAll=false --coverage src/cli src/viewer",
    "build:skill": "node scripts/build-skill.mjs",
    "check:skill": "node scripts/build-skill.mjs --check",
    "package:skill": "node scripts/build-skill.mjs --package",
    "check:viewer": "node scripts/check-viewer.mjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.2",
    "gh-pages": "^6.3.0"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/cli/**/*.js",
      "src/viewer/**/*.{js,jsx}",
      "!src/cli/bin.js",
      "!src/cli/testing/**",
      "!src/viewer/index.jsx"
    ],
    "coverageThreshold": {
      "./src/cli/": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "./src/viewer/": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  },
  "overrides": {
    "fast-uri": "^3.1.8"
  }
}
